  "constraint_rules": {
    "vehicle_to_mobility_aid": {
      "description": "Determines if a vehicle can physically accommodate a mobility aid",
      "rules": [
        {
          "if": "mobility_aid.requires_lift == True",
          "then": "vehicle.lift_equipped == True AND vehicle.lift_capacity_lbs >= mobility_aid.weight_lbs",
          "severity": "blocking",
          "message_template": "{mobility_aid} requires lift (min {lift_min} lbs). {vehicle} lift capacity: {lift_actual} lbs."
        },
        {
          "if": "mobility_aid.requires_ramp == True",
          "then": "vehicle.ramp_equipped == True AND vehicle.ramp_width_in >= mobility_aid.unfolded_dimensions_in.w",
          "severity": "blocking",
          "message_template": "{mobility_aid} requires ramp (min {ramp_min} in wide). {vehicle} ramp: {ramp_actual} in."
        },
        {
          "if": "mobility_aid.cargo_space_cu_ft > 0",
          "then": "vehicle.cargo_space_cu_ft >= mobility_aid.cargo_space_cu_ft",
          "severity": "blocking",
          "message_template": "{mobility_aid} needs {cargo_needed} cu ft cargo space. {vehicle} has {cargo_actual} cu ft."
        },
        {
          "if": "mobility_aid.power_requirement != None",
          "then": "mobility_aid.power_requirement IN vehicle.power_outlets",
          "severity": "warning",
          "message_template": "{mobility_aid} requires {power_needed} power. {vehicle} outlets: {power_actual}."
        },
        {
          "if": "mobility_aid.sequerement_points > 0",
          "then": "vehicle.sequerement_points >= mobility_aid.sequerement_points",
          "severity": "blocking",
          "message_template": "{mobility_aid} needs {secure_needed} securement points. {vehicle} has {secure_actual}."
        }
      ]
    },
    "vehicle_to_animal": {
      "description": "Determines if a vehicle can accommodate an animal",
      "rules": [
        {
          "if": "animal.legal_status == 'ADA_protected'",
          "then": "animal.rides_with_handler == True",
          "severity": "blocking",
          "message_template": "{animal} is ADA-protected service animal. Must ride with handler in passenger area."
        },
        {
          "if": "animal.vehicle_requirement == 'carrier_required'",
          "then": "vehicle.cargo_space_cu_ft >= animal.space_required_cu_ft OR vehicle.passenger_capacity >= (family_size + 1)",
          "severity": "blocking",
          "message_template": "{animal} requires carrier. Need {space_needed} cu ft or passenger seat."
        },
        {
          "if": "animal.vehicle_requirement == 'cargo'",
          "then": "vehicle.cargo_space_cu_ft >= animal.space_required_cu_ft AND vehicle.climate_control != 'none'",
          "severity": "blocking",
          "message_template": "{animal} in cargo area needs {space_needed} cu ft and climate control."
        }
      ]
    },
    "vehicle_to_family": {
      "description": "Determines if a vehicle can accommodate the entire family unit",
      "rules": [
        {
          "if": "family_size > 0",
          "then": "vehicle.passenger_capacity >= family_size",
          "severity": "blocking",
          "message_template": "Family of {family_size} needs {seats_needed} seats. {vehicle} has {seats_actual} passenger capacity."
        },
        {
          "if": "family_has_wheelchair == True",
          "then": "vehicle.wheelchair_slots >= wheelchair_count",
          "severity": "blocking",
          "message_template": "Family has {wheelchair_count} wheelchair user(s). {vehicle} has {slots_actual} wheelchair slot(s)."
        }
      ]
    },
    "shelter_to_family": {
      "description": "Determines if a shelter room can accommodate the family unit",
      "rules": [
        {
          "if": "family_size > 0",
          "then": "shelter_room.max_occupancy >= family_size",
          "severity": "blocking",
          "message_template": "Family of {family_size} exceeds {room} max occupancy of {max_occ}."
        },
        {
          "if": "family_has_wheelchair == True",
          "then": "shelter_room.wheelchair_accessible == True AND shelter_room.door_width_in >= 32",
          "severity": "blocking",
          "message_template": "Wheelchair user requires accessible room. {room} wheelchair_accessible: {wc_actual}."
        },
        {
          "if": "family_has_service_animal == True",
          "then": "shelter_room.pet_policy IN ['service_animals_only', 'all_pets']",
          "severity": "blocking",
          "message_template": "Service animal requires pet-friendly room. {room} pet_policy: {pet_actual}."
        },
        {
          "if": "family_has_pet == True AND family_has_service_animal == False",
          "then": "shelter_room.pet_policy == 'all_pets'",
          "severity": "blocking",
          "message_template": "Pet (non-service) requires all-pets room. {room} pet_policy: {pet_actual}."
        }
      ]
    },
    "operator_to_vehicle": {
      "description": "Determines if a volunteer is qualified to operate a vehicle",
      "rules": [
        {
          "if": "vehicle.operator_requirements != []",
          "then": "ALL(vehicle.operator_requirements) IN volunteer.certifications",
          "severity": "blocking",
          "message_template": "{vehicle} requires {certs_needed}. Volunteer has {certs_actual}."
        }
      ]
    }
  },
  "priority_matrix": {
    "description": "When no exact match exists, these constraints are relaxed in this order (lowest priority first)",
    "relaxation_order": [
      {
